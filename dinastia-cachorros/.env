# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinastia"

# NextAuth
NEXTAUTH_SECRET="desarrollo-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider (using resend for development)
RESEND_API_KEY="re_development_key"
EMAIL_PROVIDER="resend"

# Storage Provider (using cloudinary for development)
CLOUDINARY_URL="cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz1234567890abcd@sample"
STORAGE_PROVIDER="cloudinary"

# Cron/Jobs Provider
CRON_PROVIDER="local"

# Company Information
COMPANY_NAME="Dinastía Cachorros"
COMPANY_EMAIL="admin@dinastiacachorros.com"
COMPANY_PHONE="+57 300 123 4567"
COMPANY_ADDRESS="Calle 123 #45-67, Bogotá, Colombia"
COMPANY_TAX_ID="NIT-123456789-0"
COMPANY_LOGO_URL="/images/logo.png"

# Invoice Settings
INVOICE_PREFIX="DIN"
INVOICE_STARTING_NUMBER="1000"

# Notification Settings
VACCINE_REMINDER_DAYS="7"
LEAD_FOLLOW_UP_DAYS="3"

# Development Tools
MAILHOG_URL="http://localhost:8025"

# Security
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="15"

# Features
ENABLE_SMS_NOTIFICATIONS="false"
ENABLE_WHATSAPP_NOTIFICATIONS="false"
ENABLE_AUDIT_LOGS="true"