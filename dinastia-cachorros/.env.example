# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinastia"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider (choose one)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_PROVIDER="resend" # or "sendgrid"

# Storage Provider (choose one)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
STORAGE_PROVIDER="cloudinary" # or "supabase"

# Cron/Jobs Provider
CRON_PROVIDER="local" # or "qstash"
# QSTASH_URL="https://qstash.upstash.io"
# QSTASH_TOKEN="your-qstash-token"

# Company Information
COMPANY_NAME="Dinastía Cachorros"
COMPANY_EMAIL="admin@dinastiacachorros.com"
COMPANY_PHONE="+57 300 123 4567"
COMPANY_ADDRESS="Calle 123 #45-67, Bogotá, Colombia"
COMPANY_TAX_ID="NIT-123456789-0"
COMPANY_LOGO_URL="/images/logo.png"

# Invoice Settings
INVOICE_PREFIX="DIN"
INVOICE_STARTING_NUMBER="1000"

# Notification Settings
VACCINE_REMINDER_DAYS="7" # days before vaccination date
LEAD_FOLLOW_UP_DAYS="3" # days for next contact reminder

# Development Tools
MAILHOG_URL="http://localhost:8025" # for development email testing

# Security
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="15" # minutes

# Features
ENABLE_SMS_NOTIFICATIONS="false"
ENABLE_WHATSAPP_NOTIFICATIONS="false"
ENABLE_AUDIT_LOGS="true"